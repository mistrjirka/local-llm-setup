MODEL_ROOT="$HOME/models/local-llm-setup"
# Generated install paths can be overridden here.
QWEN38_MODEL="$HOME/models/local-llm-setup/qwen38/Qwen3.8-27B-UD-Q5_K_XL.gguf"
ORNITH15_MODEL="$HOME/models/local-llm-setup/ornith15/Ornith-1.5-35B-A3B-AD-Q6_K-Q5_K.gguf"
ORNITH15_MTP_MODEL="$HOME/models/local-llm-setup/ornith15/mtp-shisa-ornith15-all-Q5_0.gguf"
ORNITH15_MMPROJ="$HOME/models/local-llm-setup/ornith15/mmproj-Ornith-1.5-35B-BF16.gguf"
LLAMA_CACHE_ROOT="/dev/shm/local-llm-setup"
LLAMA_SWAP_LISTEN="127.0.0.1:8080"
QWEN38_CACHE_RAM_MIB=65536
# Validated extended-context profile for V100 32 GB + RTX 2080 Ti 22 GB.
# Qwen3.8 is native at 262144; the launcher automatically enables YaRN above
# that limit. 409600 / 262144 = 1.5625, which is the tested 400k profile.
QWEN38_CTX_SIZE=409600
QWEN38_NATIVE_CTX=262144
QWEN38_YARN_SCALE=1.5625
# Validated llama.cpp enumeration: V100=CUDA0, RTX 2080 Ti=CUDA1.
QWEN38_DEVICE_ORDER="CUDA1,CUDA0"
QWEN38_TENSOR_SPLIT="4,5"
# 400k needs q8_0 target KV plus smaller graph ubatches to retain MTP3.
QWEN38_CACHE_TYPE_K=q8_0
QWEN38_CACHE_TYPE_V=q8_0
QWEN38_DRAFT_CACHE_TYPE_K=f16
QWEN38_DRAFT_CACHE_TYPE_V=f16
QWEN38_UBATCH_SIZE=2048
QWEN38_DRAFT_UBATCH_SIZE=512
# Four persistent subagent slots with a 350k maximum each. This preserves Q8
# target and draft KV plus MTP3 while fitting the higher-quality target quant.
ORNITH15_PARALLEL=4
ORNITH15_CTX_PER_SLOT=350000
ORNITH15_NATIVE_CTX=262144
ORNITH15_YARN_SCALE=1.33514404296875
# Default lossless shared-prefix mode: each logical slot may reach 400k while
# all four share a 1.4M-token physical Q8 KV pool. Best for subagents forked
# from a long common parent prefix; set to 0 for guaranteed-independent 350k slots.
ORNITH15_SHARED_400K=1
ORNITH15_SHARED_CTX_PER_SLOT=400000
ORNITH15_SHARED_KV_POOL=1400000
ORNITH15_SHARED_YARN_SCALE=1.52587890625
# Used by the default fixed-slot profile; shared-400k keeps live slots resident.
ORNITH15_CACHE_RAM_MIB=32768
# Target and draft KV both stay Q8_0.
ORNITH15_CACHE_TYPE_K=q8_0
ORNITH15_CACHE_TYPE_V=q8_0
ORNITH15_DRAFT_CACHE_TYPE_K=q8_0
ORNITH15_DRAFT_CACHE_TYPE_V=q8_0
ORNITH15_DEVICE_ORDER="CUDA1,CUDA0"
ORNITH15_TENSOR_SPLIT="14,35"
ORNITH15_UBATCH_SIZE=256
ORNITH15_DRAFT_UBATCH_SIZE=128
ORNITH15_MTP_N_MAX=3
ORNITH15_MTP_DEVICE="CUDA1"
# Keep the ~903 MB vision projector on CPU so it does not consume GPU margin.
ORNITH15_MMPROJ_OFFLOAD=0
# ORNITH15_MMPROJ_DEVICE="CUDA0"  # used only when ORNITH15_MMPROJ_OFFLOAD=1
# ORNITH15_EXTRA_ARGS="..."   # replace default target placement if needed
